# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Orion OS Project Contributors
#
# /etc/calamares/branding/orion.branding — Calamares branding descriptor
# for Orion OS.
#
# Reference: https://github.com/calamares/calamares/wiki/Deploying-Calamares-Branding

---
componentName:  orion
strings:
  productName:         "Orion OS"
  shortProductName:     "Orion"
  version:              "v2026.10"
  shortVersion:         "2026.10"
  slogan:               "A polished Arch-Linux-based desktop."
  shortSlogan:          "Orion OS"
  description:          "Orion OS — Windows-inspired workflows, distinct identity."
  shortDescription:     "Orion OS installer"

images:
  productLogo:         "logo.png"
  productIcon:         "icon.png"
  productWelcome:      "welcome.png"

slideshow:             "show.qml"
slideshowAPI:          2

style:
  sidebarBackground:    "#0B0F1A"
  sidebarText:          "#F2F4F8"
  sidebarTextSelect:    "#FFFFFF"
  sidebarTextHighlight: "#2D7FF9"

uiConfig:
  font:                 "Inter"
  fontMono:             "JetBrains Mono"
  accent:               "#2D7FF9"

navigation:
  widgetStyle:          "orion"
