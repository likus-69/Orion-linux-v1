# Orion SDDM theme definition for orion-high-contrast.
# Loaded by /usr/share/sddm/themes/orion-high/.

[Theme]
Name=Orion High
Description=WCAG AAA compliant — pure black/white, no blur, no gradients, no shadows.
Author=Orion OS Project
Type=qml
Screenshot=preview.png
MainScript=Main.qml
ConfigFile=theme.conf
ThemeDir=/usr/share/sddm/themes/orion-high

# Token values for the SDDM QML theme.
[Colors]
surface0=#000000
surface1=#000000
surface2=#000000
accent=#FFFFFF
fg_primary=#FFFFFF
fg_secondary=#E0E0E0
