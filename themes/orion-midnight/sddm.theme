# Orion SDDM theme definition for orion-midnight.
# Loaded by /usr/share/sddm/themes/orion-midnight/.

[Theme]
Name=Orion Midnight
Description=OLED-friendly theme — pure black surfaces, violet accent. For OLED displays.
Author=Orion OS Project
Type=qml
Screenshot=preview.png
MainScript=Main.qml
ConfigFile=theme.conf
ThemeDir=/usr/share/sddm/themes/orion-midnight

# Token values for the SDDM QML theme.
[Colors]
surface0=#04060B
surface1=#080B14
surface2=#0F1320
accent=#7C5CFF
fg_primary=#F2F4F8
fg_secondary=#A8B0C4
