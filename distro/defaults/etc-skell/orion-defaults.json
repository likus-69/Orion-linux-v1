{
  "version": 1,
  "personalization": {
    "wallpaper": "/usr/share/orion/wallpapers/orion-dark.png",
    "theme": "orion-dark",
    "accent": "blue",
    "panel_layout": "centered",
    "panel_height": 48,
    "icon_size": 24,
    "reduce_animations": false,
    "reduce_transparency": false
  },
  "start_menu": {
    "pinned_apps": [
      "firefox.desktop",
      "orion-file-manager.desktop",
      "orion-terminal.desktop",
      "orion-settings.desktop",
      "orion-software-center.desktop"
    ],
    "show_recent_files": true,
    "max_recent_files": 12,
    "show_recommended_apps": true
  },
  "panel": {
    "pinned_apps": [
      "firefox.desktop",
      "orion-file-manager.desktop",
      "orion-terminal.desktop",
      "orion-software-center.desktop"
    ],
    "auto_hide": false,
    "show_labels": false,
    "system_tray_enabled": true
  },
  "file_manager": {
    "default_view": "icon",
    "show_hidden_files": false,
    "single_click": false
  },
  "privacy": {
    "telemetry_enabled": false,
    "report_errors": false,
    "remember_recent_files": true,
    "bluetooth_discoverable": false
  }
