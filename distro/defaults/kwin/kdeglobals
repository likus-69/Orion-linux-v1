# /etc/xdg/kdeglobals (Orion OS default)
# Read by KDE/Qt applications as the global style. The Orion Settings app
# writes user overrides to ~/.config/kdeglobals.

[KDE]
LookAndFeelPackage=org.orion.desktop
widgetStyle=orion
ColorScheme=OrionDark

[General]
ColorScheme=OrionDark
Name=Orion

[Icons]
Theme=orion

[Wallpaper]
Image=/usr/share/orion/wallpapers/orion-dark.png
