// /etc/polkit-1/rules.d/20-orion-softwarecenter.rules
//
// Polkit rules for the Orion Software Center and related Orion desktop
// components on the installed system. (The live ISO uses a more permissive
// rule in 10-orion-live.rules; this rule is the production default.)
//
// These rules grant wheel members the right to:
//   - install / remove / update packages via PackageKit (cached for 15 min)
//   - change the system timezone, hostname, and locale via Orion Settings
//   - mount / format disks via udisks2 (cached for 15 min)
//
// Non-wheel users get auth_admin (prompt) for read operations and
// auth_admin_keep for the install/remove/update operations.

polkit.addRule(function(action, subject) {
    var isWheel = subject.isInGroup("wheel");
    var isAdmin = subject.local && subject.active && isWheel;

    function allow_keep() {
        return isAdmin ? polkit.Result.YES : polkit.Result.AUTH_ADMIN_KEEP;
    }
    function allow_once() {
        return isAdmin ? polkit.Result.YES : polkit.Result.AUTH_ADMIN;
    }

    switch (action.id) {
        case "org.freedesktop.packagekit.package-install":
        case "org.freedesktop.packagekit.package-remove":
        case "org.freedesktop.packagekit.system-update":
        case "org.freedesktop.packagekit.package-repair":
            return allow_keep();

        case "org.freedesktop.packagekit.package-refresh-cache":
        case "org.freedesktop.packagekit.updates-changed":
            // Refreshing the cache is always allowed; it's a read-only operation.
            return polkit.Result.YES;

        case "org.orion.softwarecenter.install":
        case "org.orion.softwarecenter.remove":
        case "org.orion.softwarecenter.updates":
            return allow_keep();

        case "org.orion.softwarecenter.aur":
            // AUR builds are explicitly more cautious: single prompt, never
            // cached. The user must re-confirm for each AUR build.
            return allow_once();

        case "org.orion.settings.timezone":
        case "org.orion.settings.hostname":
        case "org.orion.settings.locale":
            return allow_keep();

        case "org.freedesktop.hostname1.set-hostname":
        case "org.freedesktop.timedate1.set-timezone":
        case "org.freedesktop.timedate1.set-ntp":
        case "org.freedesktop.locale1.set-locale":
            return allow_keep();

        case "org.freedesktop.udisks2.filesystem-mount-system":
        case "org.freedesktop.udisks2.modify-device-system":
        case "org.freedesktop.udisks2.format-device":
            return allow_keep();

        default:
            // Not an Orion-related action; fall through to other rules.
            return polkit.Result.NOT_HANDLED;
    }
});
