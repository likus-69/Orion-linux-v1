# /usr/lib/systemd/system/orion-packagekit-mirror.timer
#
# Runs the PackageKit cache refresh every 6 hours + at boot.

[Unit]
Description=Orion packagekit cache refresh (every 6 hours)
Requires=orion-packagekit-mirror.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=6h
Unit=orion-packagekit-mirror.service

[Install]
WantedBy=timers.target
