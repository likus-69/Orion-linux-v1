# /usr/lib/systemd/user/orion-search.service
#
# Background indexer that powers Orion Search (Start Menu search, global
# search). Indexes .desktop files, recently-used files, and user documents.
# Avoids the heavy KDE Baloo indexer; Orion Search is intentionally limited.

[Unit]
Description=Orion Search indexer
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/orion/orion-search --daemon
Restart=on-failure
RestartSec=10
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=orion.search=true
Environment=ORION_DESKTOP=1

[Install]
WantedBy=graphical-session.target
