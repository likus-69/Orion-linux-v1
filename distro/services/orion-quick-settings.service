# /usr/lib/systemd/user/orion-quick-settings.service
#
# The Orion quick-settings panel (Wi-Fi, audio, battery, calendar popover).
# Always running so it can be opened instantly by clicking the system tray.

[Unit]
Description=Orion Quick Settings
After=orion-panel.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/orion/orion-quick-settings
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=orion.quicksettings=true
Environment=ORION_DESKTOP=1

[Install]
WantedBy=graphical-session.target
