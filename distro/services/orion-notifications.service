# /usr/lib/systemd/user/orion-notifications.service
#
# The Orion notification daemon. Listens on the session D-Bus for
# notifications and displays them. Replaces `mako` or Plasma's notification
# daemon in the Orion session.

[Unit]
Description=Orion Notifications
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/orion/orion-notifications
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=orion.notifications=true
Environment=ORION_DESKTOP=1

# Provide the org.freedesktop.Notifications service on the session bus.
BusName=org.freedesktop.Notifications

[Install]
WantedBy=graphical-session.target
