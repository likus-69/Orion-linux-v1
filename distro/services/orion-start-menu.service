# /usr/lib/systemd/user/orion-start-menu.service
#
# The Orion Start Menu launcher. Started by the user's graphical session.

[Unit]
Description=Orion Start Menu
After=orion-panel.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/orion/orion-start-menu
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=orion.startmenu=true
Environment=ORION_DESKTOP=1

[Install]
WantedBy=graphical-session.target
