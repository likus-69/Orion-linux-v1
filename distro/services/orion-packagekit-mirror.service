# /usr/lib/systemd/system/orion-packagekit-mirror.service
#
# Periodically refreshes the local PackageKit cache so the Update Manager
# can show available updates without a delay when the user opens it.
# Runs as root (system service), but only performs read-only refreshes;
# installation requires polkit authorization from the GUI.

[Unit]
Description=Orion packagekit cache refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pkcon refresh force
User=root
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
