# Orion OS — packages installed in the live ISO and the installed system
#
# This file is consumed by mkarchiso (matches packages.x86_64). Lines starting
# with '#' are comments; one package per line. Groups use the 'packagegroup'
# syntax (e.g. '@packagegroup'). Relative paths starting with './' are local
# package lists sourced from the same directory.

# ---------------------------------------------------------------------------
# Base system — required to boot and run pacman
# ---------------------------------------------------------------------------
linux
linux-firmware
linux-firmware-marvell
base
base-devel

# Filesystem tools
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
f2fs-tools
ntfs-3g
xfsprogs
squashfs-tools

# Bootchain
systemd
systemd-sysvcompat
dracut
mkinitcpio
busybox
efibootmgr
sbctl

# Network (live + installed)
networkmanager
network-manager-applet
wireless_tools
wpa_supplicant
iwd
modemmanager
mobile-broadband-provider-info
openresolv

# Audio (live + installed)
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
pipewire-zeroconf
wireplumber
sof-firmware
alsa-utils
alsa-plugins
pulseaudio-alsa

# Bluetooth
