# /usr/share/applications/orion-terminal.desktop
# NOTE: Orion ships konsole as the underlying terminal engine in v1, with a
# branded wrapper that uses Orion settings and design tokens. Future
# releases may replace this with a native Qt6 terminal.

[Desktop Entry]
Name=Orion Terminal
Name[en_US]=Orion Terminal
GenericName=Terminal
GenericName[en_US]=Terminal
Comment=Command-line interface
Comment[en_US]=Command-line interface
Exec=orion-terminal
Icon=orion-os-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;Utility;Core;
StartupNotify=true
Keywords=terminal;shell;command;line;
