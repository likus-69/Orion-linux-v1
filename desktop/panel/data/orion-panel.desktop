#
# data/orion-panel.desktop — minimal application entry.
#
# The panel is normally launched by orion-panel.service (a systemd user
# unit). This .desktop file exists so users can re-launch the panel
# manually (e.g. after a crash) from a tty-launched wayland session.

[Desktop Entry]
Type=Application
Name=Orion Panel
Name[en_US]=Orion Panel
GenericName=Taskbar
Comment=Orion OS bottom taskbar (start button, pinned/running apps, tray)
Comment[en_US]=Orion OS bottom taskbar (start button, pinned/running apps, tray)
Exec=/usr/lib/orion/orion-panel
Icon=orion-logo
Terminal=false
Categories=System;DesktopUtility;
NoDisplay=true
StartupNotify=false
