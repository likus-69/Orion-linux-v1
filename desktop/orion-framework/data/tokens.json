  },
  "typography": {
    "font_family": "Inter",
    "font_family_mono": "JetBrains Mono",
    "font_family_cjk": "Noto Sans CJK SC",
    "scale": {
      "display":  { "size": 32, "weight": 600, "line_height": 1.2 },
      "h1":       { "size": 24, "weight": 600, "line_height": 1.3 },
      "h2":       { "size": 20, "weight": 600, "line_height": 1.3 },
      "h3":       { "size": 18, "weight": 500, "line_height": 1.4 },
      "body":     { "size": 15, "weight": 400, "line_height": 1.5 },
      "body-strong": { "size": 15, "weight": 600, "line_height": 1.5 },
      "caption":  { "size": 13, "weight": 400, "line_height": 1.4 },
      "overline": { "size": 11, "weight": 600, "line_height": 1.2, "letter_spacing": 0.6 },
      "mono":     { "size": 14, "weight": 400, "line_height": 1.4 }
    }
  },
  "spacing": {
    "0": 0,  "1": 4,  "2": 8,  "3": 12, "4": 16,
    "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64
  },
  "radius": {
    "none": 0, "sm": 4, "md": 8, "lg": 12, "xl": 16, "full": 9999
  },
  "elevation": {
    "dark": ["none", "0 1px 2px rgba(0,0,0,0.4)",
             "0 2px 8px rgba(0,0,0,0.45)",
             "0 8px 24px rgba(0,0,0,0.5)",
             "0 16px 48px rgba(0,0,0,0.55)"],
    "light": ["none", "0 1px 2px rgba(20,30,60,0.08)",
              "0 2px 8px rgba(20,30,60,0.10)",
              "0 8px 24px rgba(20,30,60,0.14)",
              "0 16px 48px rgba(20,30,60,0.20)"]
  },
  "motion": {
    "instant": 0,
    "fast": 120,
    "default": 200,
    "slow": 320,
    "slower": 480,
    "easing": "cubic-bezier(0.2, 0.0, 0.0, 1.0)"
  },
  "accent_presets": {
    "blue":    "#2D7FF9",
    "cyan":    "#0FB3D9",
    "violet":  "#7C5CFF",
    "magenta": "#E14FA8",
    "amber":   "#F2A93B",
    "emerald": "#2FB57C",
    "crimson": "#E14B4B"
  }
}
