# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: Orion OS Project <likus-69+release@users.noreply.github.com>
# Build the Orion Shell (Wayland session launcher).

pkgname=orion-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Orion OS desktop shell — Wayland session launcher (KWin integration)"
arch=('x86_64')
url="https://github.com/likus-69/Orion-linux-v1.1/"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-dbus' 'kwin' 'orion-framework' 'systemd' 'kinit')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("git+https://github.com/likus-69/Orion-linux-v1.1.git")
sha256sums=('SKIP')

build() {
    cd "$srcdir/Orion-linux-v1.1/desktop/shell"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build -j"$(nproc)"
}

package() {
    cd "$srcdir/Orion-linux-v1.1/desktop/shell"
    DESTDIR="$pkgdir" cmake --install build
}
