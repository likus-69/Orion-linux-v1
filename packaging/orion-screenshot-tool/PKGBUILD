pkgname=orion-screenshot-tool
pkgver=0.1.0
pkgrel=1
pkgdesc="Orion OS screenshot utility (full screen / active window / region)"
arch=('x86_64')
url="https://github.com/likus-69/Orion-linux-v1.1/"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'orion-framework')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("git+https://github.com/likus-69/Orion-linux-v1.1.git")
sha256sums=('SKIP')

build() {
    cd "$srcdir/Orion-linux-v1.1/desktop/screenshot-tool"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

package() {
    cd "$srcdir/Orion-linux-v1.1/desktop/screenshot-tool"
    DESTDIR="$pkgdir" cmake --install build
}
